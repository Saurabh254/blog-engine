---
import Base from "./Base.astro";
import ImageZoom from "../components/ImageZoom.astro";

interface Props {
    title: string;
    description?: string;
    date: Date;
    image?: string;
    slug: string;
    draft?: boolean;
}

const { title, description, date, image, slug, draft } = Astro.props;
const formatted = new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<Base
    title={title}
    description={description}
    canonicalPath={`/${slug}`}
    ogType="article"
    publishedAt={date}
    image={image}
    noindex={draft}
>
    <article itemscope itemtype="https://schema.org/BlogPosting">
        <meta itemprop="headline" content={title} />
        {description && <meta itemprop="description" content={description} />}
        <meta itemprop="datePublished" content={date.toISOString()} />

        <p class="mb-6">
            <a href="/" class="text-accent no-underline hover:underline text-sm font-medium"
                >← all posts</a
            >
        </p>

        <header class="mb-10 pb-6 border-b border-border">
            <h1
                class="text-2xl sm:text-3xl lg:text-[2.25rem] font-extrabold tracking-tight leading-[1.25] text-ink"
                itemprop="name"
            >
                {title}
            </h1>
            <time
                class="mt-2 block text-sm text-muted"
                datetime={date.toISOString()}
                itemprop="datePublished"
            >
                {formatted}
            </time>
        </header>

        <div
            class="prose prose-neutral dark:prose-invert max-w-none prose-p:text-[17px] prose-p:leading-[1.75] prose-p:my-5 prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-ink prose-h2:text-[1.65rem] prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-border/60 prose-h3:text-[1.3rem] prose-h3:mt-8 prose-h3:mb-3 prose-h4:text-[1.1rem] prose-h4:mt-6 prose-h4:mb-2 prose-li:text-[17px] prose-li:leading-relaxed prose-li:my-1.5 prose-strong:font-semibold prose-strong:text-ink prose-a:text-accent prose-a:underline hover:prose-a:text-accent-hover prose-img:my-7 prose-img:rounded-xl prose-img:border prose-img:border-border prose-img:shadow-sm prose-img:cursor-zoom-in hover:prose-img:opacity-95 transition-opacity prose-code:before:content-none prose-code:after:content-none prose-pre:border prose-pre:border-border prose-pre:rounded-xl prose-pre:text-[14.5px] prose-pre:leading-relaxed prose-pre:p-4 sm:prose-pre:p-5 prose-blockquote:border-l-4 prose-blockquote:border-accent prose-blockquote:bg-accent/[0.04] prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:rounded-r-lg prose-blockquote:not-italic prose-blockquote:text-ink prose-blockquote:my-6"
            itemprop="articleBody"
        >
            <slot />
        </div>
    </article>
    <ImageZoom />
</Base>
